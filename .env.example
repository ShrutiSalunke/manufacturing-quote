# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated HTTPS origins for CSRF (required in production), e.g.:
# CSRF_TRUSTED_ORIGINS=https://manufacturing-quote.onrender.com
CSRF_TRUSTED_ORIGINS=

# Database: leave blank for SQLite (default). Set DATABASE_URL for PostgreSQL.
# Example PostgreSQL:
# DATABASE_URL=postgres://user:password@localhost:5432/manufacturing_quote
DATABASE_URL=
# Set true on Render / hosted Postgres that requires SSL
DATABASE_SSL=false

# Optional company name shown on PDF quotes
COMPANY_NAME=Prasad Manufacturing

# Access Control pack (feature/rbac). Leave False on Main.
FEATURE_RBAC=False

# Drawing → Quote (feature/drawing-quote). Leave False until rollout.
DRAWING_QUOTE_ENABLED=False
# Vision/LLM extractor (P3+). Use "none" until a provider is configured.
DRAWING_QUOTE_VISION_PROVIDER=none
DRAWING_QUOTE_VISION_API_KEY=
DRAWING_QUOTE_VISION_MODEL=
