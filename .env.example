# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated HTTPS origins for CSRF (required in production), e.g.:
# CSRF_TRUSTED_ORIGINS=https://manufacturing-quote.onrender.com
CSRF_TRUSTED_ORIGINS=

# Database: leave blank for SQLite (default). Set DATABASE_URL for PostgreSQL.
# Example PostgreSQL:
# DATABASE_URL=postgres://user:password@localhost:5432/manufacturing_quote
DATABASE_URL=
# Set true on Render / hosted Postgres that requires SSL
DATABASE_SSL=false

# Optional company name shown on PDF quotes
COMPANY_NAME=Code Sync

# RBAC / FBAC (Access Control). Set false on Main-style basic deploys.
FEATURE_RBAC=True
